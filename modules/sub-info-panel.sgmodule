#!name=Sub Info Panel
#!desc=Show subscription usage and expiration.
#!category=gholts
#!arguments=name:-, url
#!arguments-desc=name\n  └ Panel name (optional)\nurl\n  └ Subscription URL

[Script]
sub-info-panel = type=generic,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/sub-info-panel.js,argument=name={{{name}}}&url={{{url}}},timeout=10

[Panel]
SubInfo = title="Sub Info",content="Loading...",style=info,script-name=sub-info-panel,update-interval=3600
