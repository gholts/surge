#!name=Taobao Clean
#!desc=Filter captured marketing popups and floating banners, block known splash/Tanx ads, and enable the local 88VIP icon selector. Native cart/home/detail strips and video tab are not covered. Requires HTTPS decryption.
#!category=gholts
#!version=1.0.0
#!arguments=unlock_icon:true,block_tracking:true
#!arguments-desc=unlock_icon\n  └ Patch the captured icon page's local gate; native icon switching still needs device verification\nblock_tracking\n  └ Block Taobao analytics uploads
#!requirement=SYSTEM = 'iOS'

# Build publishes this module with scripts/taobao/{response,icon}.js.
# Enable MITM, Rewrite and Scripting; trust Surge's CA on the device.
# Cached popup configuration and icon-page assets must refresh before changes apply.
# No HAR, cookies, credentials, account identifiers or captured bodies are bundled.
# Native home/detail/cart responses were absent from the capture. Their inline
# 88VIP signup strips, coupon bars and video tab need a new decoded API capture.

[Rule]
DOMAIN,ifs.tanx.com,REJECT
DOMAIN,h-adashx.ut.taobao.com,REJECT #!REQUIREMENT "'{{{block_tracking}}}' == 'true'"

[URL Rewrite]
# Public splash endpoint; absent from this capture, not device-verified.
# Reference: https://github.com/rookiediiick/Surge/blob/master/Block-Ads.sgmodule
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get\/ - reject

[Script]
taobao.clean.popups = type=http-response,pattern=^https:\/\/poplayer\.template\.alibaba\.com\/popcdn\/2\/config\.json(?:\?|$),requires-body=1,max-size=1048576,engine=jsc,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/taobao/response.js
taobao.clean.icon = type=http-response,pattern=^https:\/\/g\.alicdn\.com\/code\/npm\/@ali\/tb-vip-vip-snap-webapp\/[\d.]+\/js\/p_app-icon-setting-index\.js(?:\?|$),requires-body=1,max-size=1048576,engine=jsc,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/taobao/icon.js #!REQUIREMENT "'{{{unlock_icon}}}' == 'true'"

[MITM]
hostname = %APPEND% poplayer.template.alibaba.com, guide-acs.m.taobao.com, g.alicdn.com
