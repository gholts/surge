#!name=YouTube Enhance
#!desc=Remove YouTube ads and enable background playback, Picture in Picture, and up to 4x speed.\nOptions can hide unwanted sections, prefer the highest quality, and enable Jump Ahead.\nBased on Maasea's code (Apache-2.0).
#!category=gholts
#!arguments=block_upload:true,block_shorts:false,auto_hd:true,block_games:true,block_vertical_live:false,jump_ahead:true,block_store:true,native_download:false
#!arguments-desc=block_upload: Hide the Uploads entry from YouTube navigation.\nblock_shorts: Hide the Shorts entry from YouTube navigation.\nauto_hd: Prefer the highest available video quality and prevent automatic downgrades.\nblock_games: Hide YouTube Playables recommendations.\nblock_vertical_live: Hide vertical live recommendations across YouTube layouts.\njump_ahead: Enable YouTube's native Jump Ahead button without its promotion.\nblock_store: Hide creator stores and shopping sections under videos and on channel profiles.\nnative_download: Experimental native downloads; use 720p if quality is unset. Server restrictions may still apply.
#!requirement=SYSTEM = 'iOS'

[Script]
youtube.enhance.ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js
youtube.enhance.download = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js,argument="{"nativeDownload":{{{native_download}}}}"
youtube.enhance.download-player = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,argument="{"nativeDownload":{{{native_download}}}}"
youtube.enhance.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js,argument="{"blockUpload":{{{block_upload}}},"blockShorts":{{{block_shorts}}},"blockGames":{{{block_games}}},"blockVerticalLive":{{{block_vertical_live}}},"jumpAhead":{{{jump_ahead}}},"autoHd":{{{auto_hd}}},"blockStore":{{{block_store}}}}"
youtube.enhance.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js,argument="{"blockGames":{{{block_games}}},"blockVerticalLive":{{{block_vertical_live}}},"jumpAhead":{{{jump_ahead}}},"autoHd":{{{auto_hd}}},"blockStore":{{{block_store}}}}"
youtube.enhance.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js
youtube.enhance.auto-hd = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,argument="{"autoHd":{{{auto_hd}}}}"
youtube.enhance.log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js

[URL Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, *.youtube.com
