#!name=Feather Fully Local Manifest
#!desc=Keep Feather installs local without backloop.dev certificates or an external manifest server.\nIn Feather, select Semi Local and Only use localhost address.
#!category=gholts
#!arguments=manifest_host:api.palera.in
#!arguments-desc=manifest_host\n  └ Manifest server hostname (no scheme or path)
#!requirement=SYSTEM = 'iOS' || SYSTEM = 'macOS'

# Surge terminates the HTTPS manifest request and generates its response locally.
# Feather serves the IPA itself over plain HTTP on 127.0.0.1.
# Requires Surge CA installed and fully trusted; enable MITM, Rewrite, and Scripting.

[Script]
Feather Fully Local Manifest = type=http-request,pattern=^https:\/\/feather-manifest\.invalid\/genPlist(?:\?.*)?$,script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/feather-manifest.js

[URL Rewrite]
^https:\/\/{{{manifest_host}}}\/genPlist(\?.*)?$ https://feather-manifest.invalid/genPlist$1 header

[MITM]
hostname = %APPEND% {{{manifest_host}}}
