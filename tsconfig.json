{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmitOnError": true,
        "erasableSyntaxOnly": true,
        "moduleDetection": "legacy",
        "types": ["node"],
        "lib": ["ESNext", "DOM", "DOM.Iterable"]
    },
    "include": ["build.cts", "src/*.ts"]
}
