{
    "name": "surge-build",
    "private": true,
    "scripts": {
        "format": "prettier --write package.json tsconfig.base.json \".github/workflows/*.yml\" \"modules/**/*.{cts,ts,json}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!modules/**/*.sgmodule\"",
        "format:check": "prettier --check package.json tsconfig.base.json \".github/workflows/*.yml\" \"modules/**/*.{cts,ts,json}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!modules/**/*.sgmodule\"",
        "build": "npm run build --workspaces",
        "build:check": "npm run build:check --workspaces"
    },
    "devDependencies": {
        "@types/node": "24.19.1",
        "prettier": "3.9.9",
        "terser": "5.51.2",
        "typescript": "7.0.2"
    },
    "prettier": {
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "workspaces": [
        "modules/*"
    ]
}
