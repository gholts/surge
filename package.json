{
    "name": "surge-build",
    "private": true,
    "scripts": {
        "build": "bun tools/build.ts",
        "build:check": "bun tools/build.ts --check",
        "build:pages": "bun --check tools/pages.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/node": "24.19.1",
        "terser": "5.51.2",
        "typescript": "7.0.2"
    },
    "prettier": {
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
