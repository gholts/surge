{
    "name": "surge-build",
    "private": true,
    "scripts": {
        "build": "bun run --workspaces build",
        "build:check": "bun run --workspaces build:check"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/node": "24.19.1",
        "terser": "5.51.2",
        "typescript": "7.0.2"
    },
    "prettier": {
        "tabWidth": 4,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "workspaces": [
        "modules/*"
    ]
}
